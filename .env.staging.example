# Staging student frontend (Vercel staging project OR Preview env group).
# Set NEXT_PUBLIC_APP_ENV=staging so the app never falls back to production Railway.
# See docs/staging-environment.md

NEXT_PUBLIC_APP_ENV=staging

# Must be the staging Railway API — never backend-production-a813.up.railway.app
API_URL=https://YOUR_STAGING_API_HOST
NEXT_PUBLIC_API_URL=https://YOUR_STAGING_API_HOST

NEXT_PUBLIC_AUTH_ENABLED=true
NEXT_PUBLIC_PHONE_OTP_ENABLED=false
NEXT_PUBLIC_EMAIL_OTP_ENABLED=false

# Staging public origin (OAuth, metadataBase)
NEXT_PUBLIC_OAUTH_SITE_URL=https://YOUR_STAGING_FRONTEND_HOST

ADMIN_ALLOWED_EMAIL=product@matalabs.io

# Optional multi-SKU diagnostic offer on staging
# NEXT_PUBLIC_DIAGNOSTIC_MULTI_SKU_RECOMMEND=true

# Backend (Railway staging) must allow this origin:
#   APP_ENV=staging
#   FRONTEND_URL=https://YOUR_STAGING_FRONTEND_HOST
#   CORS_ORIGINS=https://YOUR_STAGING_FRONTEND_HOST
#   GOOGLE_REDIRECT_URI=https://YOUR_STAGING_FRONTEND_HOST/api/auth/google/callback
#
# Do NOT copy Production env into this staging project.
# Vercel Preview without NEXT_PUBLIC_APP_ENV=staging still uses production API
# fallback by design — that is NOT a safe Dual E2E environment.
