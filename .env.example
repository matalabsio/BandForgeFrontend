# Copy to .env for local development (see README).

# Local FastAPI (uvicorn app.main:app --host 127.0.0.1 --port 8000)
# API_URL is for local dev only — do NOT set on Vercel (use NEXT_PUBLIC_API_URL).
API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_AUTH_ENABLED=true
# Phone OTP login UI (/verify-phone). Requires backend PHONE_OTP_ENABLED + MSG91.
NEXT_PUBLIC_PHONE_OTP_ENABLED=false

# Single admin email allowlist — used by backend admin API (admin/web also needs this)
ADMIN_ALLOWED_EMAIL=product@matalabs.io

# Admin UI now lives in admin/web (next dev -p 3001). Student app no longer serves /admin.

# Production — Vercel project bandforge-web (https://bandforge-web.vercel.app)
# Set the same NEXT_PUBLIC_* vars for Production AND Preview in Vercel, then redeploy.
# NEXT_PUBLIC_API_URL=https://backend-production-a813.up.railway.app
# NEXT_PUBLIC_OAUTH_SITE_URL=https://bandforge-web.vercel.app
# NEXT_PUBLIC_AUTH_ENABLED=true
# Verify after deploy: curl https://bandforge-web.vercel.app/api/health
# Railway API must also allow this origin: FRONTEND_URL + CORS + GOOGLE_REDIRECT_URI.

# Hero talking head — fallback only. Prefer Admin → Videos → Hero (hero-intro).
# NEXT_PUBLIC_HERO_STREAM_UID=
# NEXT_PUBLIC_HERO_STREAM_CUSTOMER=customer-xxxxx
# NEXT_PUBLIC_HERO_STREAM_POSTER=
