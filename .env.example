# Copy to .env for local development (see README).

# Local FastAPI (uvicorn app.main:app --host 127.0.0.1 --port 8000)
API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_AUTH_ENABLED=true

# Production / Netlify deploy
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# NEXT_PUBLIC_AUTH_ENABLED=true

# Using EC2 from local Next — Google OAuth will use EC2 GOOGLE_REDIRECT_URI (Netlify), not localhost
# NEXT_PUBLIC_API_URL=http://YOUR_EC2_IP:8000
