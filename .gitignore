# ---------------------------------------------------------------------------
# BandForge frontend (Next.js + TypeScript + Serwist) .gitignore
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
!.yarn/sdks

# Next.js / build output
.next/
out/
build/
dist/
.vercel
.netlify
analyze/

# TypeScript
*.tsbuildinfo
# Generated by `next` — keep local; do not rely on a committed copy
next-env.d.ts

# Testing & coverage
coverage/
.nyc_output/
playwright-report/
test-results/
/playwright/.cache/
/playwright/.auth/

# Caches
.turbo/
.eslintcache
.stylelintcache
.cache/
.parcel-cache/
.swc/
.webpack/
.rpt2_cache/
.rts2_cache_*/

# ---------------------------------------------------------------------------
# Environment & secrets — NEVER commit real values
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.production.example
!.env*.example

# Local TLS / certs
certificates/
*.pem
*.p12
*.key
!*.key.example

# ---------------------------------------------------------------------------
# Logs & debug
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# ---------------------------------------------------------------------------
# OS & editor
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# ---------------------------------------------------------------------------
# Local agent / tooling artifacts
# ---------------------------------------------------------------------------
.cursor/
.claude/
.agents/
.agent/
.codex/

# ---------------------------------------------------------------------------
# Misc local dumps (never commit)
# ---------------------------------------------------------------------------
*.local
!*.example
tmp/
temp/
.scratch/
