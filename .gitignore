# ---------------------------------------------------------------------------
# BandForge frontend (Next.js + TypeScript) .gitignore
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
!.yarn/sdks

# Next.js build output
.next/
out/
build/
dist/

# Production bundles / analysis
.vercel
.netlify
analyze/
*.tsbuildinfo
next-env.d.ts

# Testing & coverage
coverage/
.nyc_output/
playwright-report/
test-results/
/playwright/.cache/

# Caches
.turbo/
.eslintcache
.cache/
.parcel-cache/
.swc/

# ---------------------------------------------------------------------------
# Environment & secrets — NEVER commit real values
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.production.example

# ---------------------------------------------------------------------------
# Logs & debug
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------------------
# OS & editor cruft
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
*.pem
*.swp
*.swo
*~
.idea/
.vscode/
!.vscode/extensions.json

# ---------------------------------------------------------------------------
# Local agent / tooling artifacts
# ---------------------------------------------------------------------------
.cursor/
.claude/
.agents/
