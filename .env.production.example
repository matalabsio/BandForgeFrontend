# Vercel — set for BOTH Production and Preview.
# API_URL is runtime (no redeploy). NEXT_PUBLIC_API_URL is build-time (requires redeploy).

API_URL=https://adequate-surprise-production-0f84.up.railway.app
NEXT_PUBLIC_API_URL=https://adequate-surprise-production-0f84.up.railway.app
NEXT_PUBLIC_AUTH_ENABLED=true
NEXT_PUBLIC_PHONE_OTP_ENABLED=false
NEXT_PUBLIC_OAUTH_SITE_URL=https://bandforge-web.vercel.app
ADMIN_ALLOWED_EMAIL=product@matalabs.io

# Optional: extra Vercel production hostnames (comma-separated team aliases)
# NEXT_PUBLIC_PRODUCTION_HOSTS=bandforge-web-product-2554s-projects.vercel.app

# Railway API must allow the frontend (set on backend, not Vercel):
# FRONTEND_URL=https://bandforge-web.vercel.app
# GOOGLE_REDIRECT_URI=https://bandforge-web.vercel.app/api/auth/google/callback
# CORS_ORIGINS=https://bandforge-web.vercel.app

# After deploy, verify BFF → API:
# curl https://bandforge-web.vercel.app/api/health
