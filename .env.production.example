# Vercel — set for BOTH Production and Preview.
# API_URL is runtime (no redeploy). NEXT_PUBLIC_API_URL is build-time (requires redeploy).

API_URL=https://backend-production-a813.up.railway.app
NEXT_PUBLIC_API_URL=https://backend-production-a813.up.railway.app
NEXT_PUBLIC_AUTH_ENABLED=true
# Flip to true only after MSG91 is configured and backend PHONE_OTP_ENABLED=true.
NEXT_PUBLIC_PHONE_OTP_ENABLED=false
# Flip to true only after Resend is configured and backend EMAIL_OTP_ENABLED=true.
NEXT_PUBLIC_EMAIL_OTP_ENABLED=false

# Canonical public host for OAuth, metadataBase, robots.txt, and sitemap.xml.
NEXT_PUBLIC_OAUTH_SITE_URL=https://bandforgeuinew.vercel.app

ADMIN_ALLOWED_EMAIL=product@matalabs.io

# Optional: extra Vercel production hostnames (comma-separated team aliases)
# NEXT_PUBLIC_PRODUCTION_HOSTS=

# Railway API must allow the frontend (set on backend, not Vercel).
# Keep these in sync with NEXT_PUBLIC_OAUTH_SITE_URL:
# FRONTEND_URL=https://bandforgeuinew.vercel.app
# GOOGLE_REDIRECT_URI=https://bandforgeuinew.vercel.app/api/auth/google/callback
# CORS_ORIGINS=https://bandforgeuinew.vercel.app

# After deploy, verify BFF → API:
# curl https://bandforgeuinew.vercel.app/api/health
# SEO smoke: curl https://frontend-chi-ebon-lxy95up4j4.vercel.app/robots.txt
#            curl https://frontend-chi-ebon-lxy95up4j4.vercel.app/sitemap.xml | head

# Landing hero fallback only. Admin → Videos → Hero (hero-intro) wins via
# GET /api/marketing/hero. Keep these so production still plays if that row
# is empty. NEXT_PUBLIC_* is inlined at build time.
NEXT_PUBLIC_HERO_STREAM_UID=479d46fb3847e47b3a569d6a9ae05586
NEXT_PUBLIC_HERO_STREAM_CUSTOMER=customer-v3lxo54ja5bjxf7e
NEXT_PUBLIC_HERO_STREAM_POSTER=https://customer-v3lxo54ja5bjxf7e.cloudflarestream.com/479d46fb3847e47b3a569d6a9ae05586/thumbnails/thumbnail.jpg?time=2s&height=720
