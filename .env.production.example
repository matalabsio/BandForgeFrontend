# Vercel — set for BOTH Production and Preview.
# API_URL is runtime (no redeploy). NEXT_PUBLIC_API_URL is build-time (requires redeploy).

API_URL=https://adequate-surprise-production-96bc.up.railway.app
NEXT_PUBLIC_API_URL=https://adequate-surprise-production-96bc.up.railway.app
NEXT_PUBLIC_AUTH_ENABLED=true
# Flip to true only after MSG91 is configured and backend PHONE_OTP_ENABLED=true.
NEXT_PUBLIC_PHONE_OTP_ENABLED=false

# Canonical public host for OAuth, metadataBase, robots.txt, and sitemap.xml.
# Controlled ONLY by this variable (see frontend/lib/site.ts → CANONICAL_SITE_URL).
# Current production: Vercel. Later cutover to bandforge.study: change this value
# (and Railway FRONTEND_URL / CORS_ORIGINS / GOOGLE_REDIRECT_URI + Google OAuth
# redirect URI) — do not hard-code the new domain in page components.
NEXT_PUBLIC_OAUTH_SITE_URL=https://bandforge-web.vercel.app

ADMIN_ALLOWED_EMAIL=product@matalabs.io

# Optional: extra Vercel production hostnames (comma-separated team aliases)
# NEXT_PUBLIC_PRODUCTION_HOSTS=bandforge-web-product-2554s-projects.vercel.app

# Railway API must allow the frontend (set on backend, not Vercel).
# Keep these in sync with NEXT_PUBLIC_OAUTH_SITE_URL:
# FRONTEND_URL=https://bandforge-web.vercel.app
# GOOGLE_REDIRECT_URI=https://bandforge-web.vercel.app/api/auth/google/callback
# CORS_ORIGINS=https://bandforge-web.vercel.app

# After deploy, verify BFF → API:
# curl https://bandforge-web.vercel.app/api/health
# SEO smoke: curl https://bandforge-web.vercel.app/robots.txt
#            curl https://bandforge-web.vercel.app/sitemap.xml | head
